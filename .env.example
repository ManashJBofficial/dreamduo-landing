# Default for production behind path-based proxy (https://<domain>/api/*)
NEXT_PUBLIC_WAITLIST_API_BASE_URL=/api
NEXT_PUBLIC_WAITLIST_ENABLED=false

# Optional: GA4 web stream ID for campaign and download-event reporting.
# Without this, the existing Vercel Analytics integration is used alone.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: provider token from App Store Connect's campaign link builder.
# Required with ct for Apple's campaign install attribution, not web click tracking.
# NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=123456789

# Local dev alternative:
# NEXT_PUBLIC_WAITLIST_API_BASE_URL=http://127.0.0.1:9012
